# Copy this file to .env and fill in your keys

# Anthropic API key (for Claude Haiku NL parsing)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenWeatherMap API key (free tier — sign up at openweathermap.org)
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Paphos, Cyprus coordinates (used for weather forecast)
WEATHER_LAT=34.7757
WEATHER_LON=32.4341
WEATHER_CITY=Paphos

# Flask settings
FLASK_PORT=5000
FLASK_DEBUG=false
